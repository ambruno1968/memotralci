# MemoTralci - Configurazione Google & Server
PORT=3001

# ID del Calendario Google specifico (es: tuo-indirizzo@gmail.com oppure c_xxxxxxxx@group.calendar.google.com)
GOOGLE_CALENDAR_ID=

# ID della cartella Google Drive specifica per gli allegati (lo trovi dall'URL della cartella su Drive: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=

# Percorso relativo o assoluto al file JSON della Service Account Google
GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json

# (Alternativa facoltativa): inserire l'intero contenuto JSON del Service Account come stringa unica
# GOOGLE_SERVICE_ACCOUNT_JSON=

